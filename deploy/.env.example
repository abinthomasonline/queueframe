# Generated deployments use deploy/.env (mode 600). Run ./deploy/setup.sh;
# do not put real secrets in this example or commit the generated file.

COMPOSE_PROJECT_NAME=queueframe
COMPOSE_PROFILES=domain
QUEUEFRAME_DEPLOY_MODE=domain
# Source builds use queueframe:local. Public reviewed releases can instead use
# ghcr.io/abinthomasonline/queueframe:VERSION@sha256:DIGEST without login.
QUEUEFRAME_IMAGE=queueframe:local

# Queueframe always stays on the private Compose network in this stack.
QUEUEFRAME_BASE_URL=https://queueframe.example.com
QUEUEFRAME_MASTER_KEY=
QUEUEFRAME_ADMIN_USER=admin
QUEUEFRAME_ADMIN_PASSWORD=
QUEUEFRAME_SECURE_COOKIES=true
QUEUEFRAME_EXPECTED_PUBLIC_IP=203.0.113.10
# Dedicated proxy/app bridge and the only non-loopback trusted-proxy range.
QUEUEFRAME_DOCKER_SUBNET=172.30.255.0/24
QUEUEFRAME_DRY_RUN=true
QUEUEFRAME_WARM_BEFORE=10s
QUEUEFRAME_LATE_CUTOFF=5s
QUEUEFRAME_WEB_SESSION_TTL=12h

# Domain mode. QUEUEFRAME_INGRESS_IP is checked against public DNS by doctor.
QUEUEFRAME_HOSTNAME=queueframe.example.com
QUEUEFRAME_INGRESS_IP=203.0.113.10
ACME_EMAIL=admin@example.com

# Tailscale mode. Use a one-off, pre-authorized auth key and enable HTTPS for
# the tailnet. The running doctor requires the joined node's actual DNS name to
# exactly match TAILSCALE_FQDN; seal removes the key after that check succeeds.
TAILSCALE_FQDN=queueframe.example-tailnet.ts.net
TAILSCALE_HOSTNAME=queueframe
TAILSCALE_AUTHKEY=

# Public-IP mode. IPv6 site addresses use brackets, for example
# https://[2001:db8::10]. Certificates use Let's Encrypt's shortlived profile.
QUEUEFRAME_CADDY_IP_SITE=https://203.0.113.10

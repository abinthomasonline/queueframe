# Copy to .env. Never commit the populated file.

# Required: generate with `openssl rand -base64 32` and keep it stable.
QUEUEFRAME_MASTER_KEY=

# Required only when bootstrapping an empty database. Minimum 12 characters.
QUEUEFRAME_ADMIN_USER=admin
QUEUEFRAME_ADMIN_PASSWORD=

# HTTP and persistence.
QUEUEFRAME_ADDR=127.0.0.1:8080
QUEUEFRAME_BASE_URL=http://localhost:8080
QUEUEFRAME_DB=./data/queueframe.db
QUEUEFRAME_SECURE_COOKIES=false

# Public outbound address submitted to Zerodha's static-IP whitelist. Signup is
# disabled while this is empty. The Kite redirect URL is derived as
# <QUEUEFRAME_BASE_URL>/auth/kite/callback.
QUEUEFRAME_EXPECTED_PUBLIC_IP=

# Comma-separated proxy CIDRs allowed to supply X-Forwarded-For. Leave empty
# for direct/local access. The deploy/ stack sets this to its private network.
QUEUEFRAME_TRUSTED_PROXY_CIDRS=

# Safe default. Change to false only after a full dry-run rehearsal.
QUEUEFRAME_DRY_RUN=true

# Operational timing. Dispatch, freeze, blackout, interval and per-user order
# limits are versioned in SQLite and edited from the administrator dashboard.
QUEUEFRAME_WARM_BEFORE=10s
QUEUEFRAME_LATE_CUTOFF=5s
QUEUEFRAME_WEB_SESSION_TTL=12h
